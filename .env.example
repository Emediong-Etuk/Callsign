# Callsign environment. Copy to .env.local (gitignored). `npm run setup:testnet`
# fills most of these for you. NEVER commit real values.

# --- network (testnet only) ---
NEAR_NETWORK=testnet
# Public testnet RPC (docs.near.org/api/rpc/providers). Defaults shown.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_FALLBACK_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- contracts (public account ids; written by setup:testnet) ---
NEXT_PUBLIC_VAULT_CONTRACT_ID=
NEXT_PUBLIC_TOKEN_CONTRACT_ID=

# --- NEAR AI Cloud (server-only, optional: without a key the app uses rules only) ---
NEARAI_API_KEY=
# Confidential TEE model, chosen from GET /v1/models + attestation (see PROGRESS.md)
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# --- demo mode (server signs with TESTNET demo keys) ---
DEMO_MODE=true
DEMO_FINANCE_ACCOUNT_ID=
# Tolu's FUNCTION-CALL key only (request_payout/cancel_payout on the vault). Never a full-access key.
DEMO_FINANCE_FCK_SECRET=
# Optional: Tolu's full-access key, used only to show it still can't confirm (attack demo).
DEMO_FINANCE_SECRET=
DEMO_CEO_ACCOUNT_ID=
# Testnet-only full-access key of the fictional CEO account.
DEMO_CEO_SECRET=

# --- scripts only (never deploy these to a host) ---
OWNER_ACCOUNT_ID=
OWNER_SECRET=
# Demo hold window for setup:testnet (seconds, 60..604800). Default 300.
HOLD_WINDOW_SECONDS=300
# Gas allowance for Tolu's function-call key (NEAR). Default 2.
FCK_ALLOWANCE_NEAR=2
